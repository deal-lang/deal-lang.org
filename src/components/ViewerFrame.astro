---
// Themed wrapper for embedding a self-contained DEAL Viewer mockup (public/viewer/*.html)
// as a live, lazy-loaded preview. Mirrors TermDemo.astro's title-bar + panel-body styling
// so the embed sits flush with the rest of the docs (rounded corners, hairline border).
//
// The framed mockups are first-party, fully self-contained pages we ship ourselves, so no
// `sandbox` is applied: the mockups' own light/dark toggle uses localStorage, which a
// script-only sandbox (null origin) would break. Same-origin framing is permitted via the
// `/viewer/*` rule in public/_headers (the site default is X-Frame-Options: DENY).
interface Props {
  /** Path to the mockup under public/, e.g. "/viewer/example.html". */
  src: string;
  /** Caption shown in the frame's title bar. */
  title: string;
  /** Visible height of the embed. Defaults to 520px. */
  height?: number;
}

const { src, title, height = 520 } = Astro.props;
---

<figure class="dl-frame">
  <figcaption class="dl-frame-bar">{title}</figcaption>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    style={`height:${height}px`}
  ></iframe>
</figure>

<style>
  .dl-frame {
    margin: 1.2rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    overflow: hidden;
    background: var(--sl-color-gray-6);
  }
  .dl-frame-bar {
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-family: var(--__sl-font-mono, monospace);
    font-size: 0.78rem;
    color: var(--sl-color-gray-2);
  }
  .dl-frame iframe {
    display: block;
    width: 100%;
    border: 0;
    background: #fff; /* mockups paint their own canvas; white avoids a dark flash on load */
  }
</style>
