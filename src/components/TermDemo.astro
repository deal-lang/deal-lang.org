<style>
  .dl-term { background: #0d1626; border: 1px solid var(--sl-color-gray-5); border-radius: 12px; overflow: hidden; margin-top: 1.2rem; }
  .dl-term-bar { padding: 0.6rem 0.9rem; border-bottom: 1px solid #1e2a40; font-family: var(--__sl-font-mono, monospace); font-size: 0.78rem; color: #6b7c93; }
  .dl-term pre { margin: 0; padding: 1.1rem; overflow-x: auto; font-family: var(--__sl-font-mono, monospace); font-size: 0.8rem; line-height: 1.7; color: #cdd9e8; background: transparent; }
  .t-ok { color: #34d399; } .t-no { color: #f87171; } .t-wn { color: #fbbf24; }
  .t-mut { color: #6b7c93; } .t-cy { color: #22b8cf; } .t-pr { color: #7dd3fc; }
</style>
